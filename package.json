{
  "name": "dupply",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo dev --filter=@dupply/web",
    "dev:web": "turbo dev --filter=@dupply/web",
    "dev:console": "turbo dev --filter=@dupply/console",
    "dev:api": "dotenv -e .env.local -- pnpm exec vercel dev --listen 3000",
    "dev:local": "concurrently --names api,console -c blue,magenta \"pnpm dev:api\" \"pnpm dev:console\"",
    "build": "turbo build",
    "build:api": "pnpm --filter @dupply/types build && pnpm --filter @dupply/diagnostico build && node scripts/bundle-diagnostico-handler.mjs && node scripts/bundle-console-diagnosticos.mjs && node scripts/bundle-diagnostico-smoke.mjs",
    "build:vercel": "pnpm build:api && pnpm --filter @dupply/web build && pnpm --filter @dupply/console build",
    "lint": "turbo lint",
    "preview": "pnpm --filter @dupply/web preview",
    "test:diagnostico:prod": "dotenv -e .env.local -- node scripts/smoke-diagnostico.mjs",
    "test:diagnostico:sheets": "SMOKE_MODE=sheets dotenv -e .env.local -- node scripts/smoke-diagnostico.mjs",
    "db:push": "pnpm --filter @dupply/db push",
    "db:studio": "pnpm --filter @dupply/db studio",
    "db:import-sheets": "dotenv -e .env.local -- node scripts/import-sheets-csv.mjs"
  },
  "dependencies": {
    "@dupply/api": "workspace:*",
    "@dupply/db": "workspace:*",
    "@dupply/diagnostico": "workspace:*",
    "@dupply/types": "workspace:*",
    "@vercel/functions": "^3.7.5",
    "@vercel/node": "^5.8.22",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@neondatabase/serverless": "^1.0.1",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^10.0.0",
    "drizzle-orm": "^0.44.5",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "turbo": "^2.5.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vercel": "^54.20.1"
  }
}
