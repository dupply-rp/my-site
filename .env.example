# Anthropic — relatório com IA
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Google Sheets — webhook do Apps Script (URL terminando em /exec)
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/SEU_ID/exec

# Segredo compartilhado entre API e Apps Script (opcional, recomendado)
DIAGNOSTICO_WEBHOOK_SECRET=um-token-aleatorio-longo

# Fila de retry — Upstash Redis (Vercel Marketplace → Upstash)
UPSTASH_REDIS_REST_URL=https://SEU-ENDPOINT.upstash.io
UPSTASH_REDIS_REST_TOKEN=seu-token-upstash

# Cron da Vercel — gerado automaticamente ao ativar Crons no projeto
# Plano Hobby: no máximo 1 execução/dia (vercel.json usa 0 9 * * * = 06:00 BRT)
CRON_SECRET=gerado-pela-vercel

# Smoke test em produção — scripts/smoke-diagnostico.mjs
DIAGNOSTICO_TEST_SECRET=token-longo-para-teste
SMOKE_BASE_URL=https://dupply.com.br
SMOKE_MODE=full
