# Dupply — variáveis de ambiente
# Local: copie para .env.local
# VPS/Coolify: copie deploy/env.producao.template → .env.producao

# --- Anthropic (relatório com IA) ---
ANTHROPIC_API_KEY=sk-ant-api03-...

# --- Resend (e-mail) ---
# https://resend.com/domains — verificar dupply.com.br
RESEND_API_KEY=re_...
REPORT_EMAIL_FROM=Diagnóstico Dupply <relatorio@dupply.com.br>
DIAGNOSTICO_NOTIFY_EMAILS=ricardo.lima@dupply.com.br,ricardosllacerda@gmail.com

# --- Console interno (/console) ---
CONSOLE_SECRET=um-token-longo-e-aleatorio

# --- Google Sheets (opcional; desligado por padrão no VPS) ---
# ENABLE_GOOGLE_SHEETS=true
# GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/SEU_ID/exec
# DIAGNOSTICO_WEBHOOK_SECRET=seu-secret-webhook

# --- Upstash Redis REST (rate limit + fila retry) ---
# NÃO use REDIS_URL — o código lê UPSTASH_REDIS_REST_*
UPSTASH_REDIS_REST_URL=https://SEU-ENDPOINT.upstash.io
UPSTASH_REDIS_REST_TOKEN=seu-token-upstash
DIAGNOSTICO_RATE_LIMIT_MAX=5
DIAGNOSTICO_RATE_LIMIT_WINDOW_SEC=3600

# --- Cloudflare Turnstile ---
TURNSTILE_SECRET_KEY=seu-secret-turnstile
VITE_TURNSTILE_SITE_KEY=seu-site-key-turnstile

# --- Cron (Coolify Scheduled Task ou Vercel Crons) ---
CRON_SECRET=token-longo-aleatorio

# --- Postgres ---
# Local/dev: Neon ou Postgres local
# VPS/Coolify: URL interna do container db-diagnostico
DATABASE_URL=postgresql://user:password@host:5432/postgres
DEFAULT_TENANT_SLUG=dupply

# --- Runtime API (Coolify my-site-api) ---
NODE_ENV=production
PORT=3000
ENABLE_GOOGLE_SHEETS=false

# --- Front (build Vite — Coolify my-site) ---
VITE_SITE_URL=https://dupply.com.br

# --- Smoke test (scripts locais) ---
DIAGNOSTICO_TEST_SECRET=token-longo-para-teste
SMOKE_BASE_URL=https://www.dupply.com.br
SMOKE_MODE=full
