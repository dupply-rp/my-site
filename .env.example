# Anthropic — relatório com IA (obrigatório em produção para análise completa)
# Configure em Vercel → Settings → Environment Variables — nunca commite a chave real
ANTHROPIC_API_KEY=sk-ant-api03-...

# Resend — cópia do relatório por e-mail ao cliente
# https://resend.com — domínio verificado em dupply.com.br
RESEND_API_KEY=re_...
REPORT_EMAIL_FROM=Diagnóstico Dupply <relatorio@dupply.com.br>

# Google Sheets — webhook do Apps Script (URL terminando em /exec)
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/SEU_ID/exec

# Segredo compartilhado entre API e Apps Script (opcional, recomendado)
DIAGNOSTICO_WEBHOOK_SECRET=um-token-aleatorio-longo

# Fila de retry + rate limit — Upstash Redis (Vercel Marketplace → Upstash)
UPSTASH_REDIS_REST_URL=https://SEU-ENDPOINT.upstash.io
UPSTASH_REDIS_REST_TOKEN=seu-token-upstash

# Rate limit do diagnóstico (por IP, via Upstash)
DIAGNOSTICO_RATE_LIMIT_MAX=5
DIAGNOSTICO_RATE_LIMIT_WINDOW_SEC=3600

# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=seu-secret-turnstile
VITE_TURNSTILE_SITE_KEY=seu-site-key-turnstile

# Cron da Vercel — gerado automaticamente ao ativar Crons no projeto
# Plano Hobby: no máximo 1 execução/dia (vercel.json usa 0 9 * * * = 06:00 BRT)
CRON_SECRET=gerado-pela-vercel

# Postgres — Neon via Vercel Marketplace (Storage → Neon Postgres)
# Após conectar: vercel env pull .env.local
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DEFAULT_TENANT_SLUG=dupply

# Console interno — senha para acessar dupply.com.br/console
CONSOLE_SECRET=um-token-longo-e-aleatorio

# Smoke test em produção — scripts/smoke-diagnostico.mjs
DIAGNOSTICO_TEST_SECRET=token-longo-para-teste
SMOKE_BASE_URL=https://dupply.com.br
SMOKE_MODE=full
