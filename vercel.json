{
  "buildCommand": "pnpm build",
  "devCommand": "pnpm --filter @dupply/web exec vite --host --port $PORT",
  "outputDirectory": "apps/web/dist",
  "installCommand": "pnpm install",
  "functions": {
    "api/diagnostico.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/diagnostico/smoke.ts": {
      "maxDuration": 60
    },
    "api/cron/retry-sheets.ts": {
      "maxDuration": 60
    },
    "api/console/*.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/retry-sheets",
      "schedule": "0 9 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/console",
      "destination": "/console/index.html"
    },
    {
      "source": "/console/:path*",
      "destination": "/console/index.html"
    },
    {
      "source": "/((?!api/|console/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "projetos.dupply.com.br"
        }
      ],
      "destination": "https://sprints.zoho.com/workspace/dupply#projects",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "drive.dupply.com.br"
        }
      ],
      "destination": "https://workdrive.zoho.com/vuf8c0066ef49e7bf4c038f2d866e32e786e2/privatespace/folders/files",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "webmail.dupply.com.br"
        }
      ],
      "destination": "https://accounts.zoho.com/signin?service_language=pt&servicename=VirtualOffice&signupurl=https://www.zoho.com/pt-br/mail/zohomail-pricing.html&serviceurl=https://mail.zoho.com",
      "permanent": true
    }
  ]
}
