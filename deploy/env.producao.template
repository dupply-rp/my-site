# =============================================================================
# Dupply — produção no Coolify (VPS)
# Copie para .env.producao na raiz e preencha os __COLE_AQUI_*.
# =============================================================================
# Importação no Coolify (Developer view):
#
# 1) App my-site-api (Node): importe TODAS as variáveis deste arquivo,
#    EXCETO as que começam com VITE_ e as de smoke (SMOKE_*).
#
# 2) App my-site (estático): importe SOMENTE:
#    - VITE_SITE_URL
#    - VITE_TURNSTILE_SITE_KEY
#
# Removidas vs Vercel: VERCEL_*, TURBO_*, REDIS_URL (não usada), Neon extras.
# =============================================================================

# --- Runtime (my-site-api) ---
NODE_ENV=production
PORT=3000

# Postgres interno Coolify (db-diagnostico — host = nome do container)
DATABASE_URL=postgres://postgres:SENHA@NOME_CONTAINER_POSTGRES:5432/postgres
DEFAULT_TENANT_SLUG=dupply

# Anthropic — relatório com IA
ANTHROPIC_API_KEY=sk-ant-api03-...

# Resend — e-mail do relatório e notificação interna
RESEND_API_KEY=re_...
REPORT_EMAIL_FROM=Diagnóstico Dupply <relatorio@dupply.com.br>
DIAGNOSTICO_NOTIFY_EMAILS=ricardo.lima@dupply.com.br,ricardosllacerda@gmail.com

# Console interno (/console)
CONSOLE_SECRET=um-token-longo-e-aleatorio

# Cloudflare Turnstile (secret = API; site key = build do site estático)
TURNSTILE_SECRET_KEY=seu-secret-turnstile

# Upstash Redis REST — rate limit + fila de retry (NÃO use REDIS_URL)
UPSTASH_REDIS_REST_URL=https://SEU-ENDPOINT.upstash.io
UPSTASH_REDIS_REST_TOKEN=seu-token-upstash
DIAGNOSTICO_RATE_LIMIT_MAX=5
DIAGNOSTICO_RATE_LIMIT_WINDOW_SEC=3600

# Cron Coolify (Scheduled Task 0 9 * * * → /api/cron/retry-sheets)
CRON_SECRET=token-longo-aleatorio-para-cron

# Google Sheets — desligado (Fase 1 usa só Postgres)
ENABLE_GOOGLE_SHEETS=false

# Smoke test (opcional; só scripts locais — NÃO precisa no Coolify)
DIAGNOSTICO_TEST_SECRET=token-longo-para-teste
SMOKE_BASE_URL=https://www.dupply.com.br
SMOKE_MODE=full

# --- Build (my-site estático) — importar só no app do site ---
VITE_SITE_URL=https://dupply.com.br
VITE_TURNSTILE_SITE_KEY=seu-site-key-turnstile
